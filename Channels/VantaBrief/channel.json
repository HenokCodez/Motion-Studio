{
  "id": "VantaBrief",
  "name": "VantaBrief",
  "tagline": "Concise Intelligence & Software Engineering Breakdowns",
  "audience": "Developers, AI researchers, automation engineers, technical founders",
  "style": {
    "theme": "vanta_charcoal_modern",
    "palette": {
      "background": "#231F20",
      "background_subtle": "#2C2728",
      "surface": "#1C191A",
      "surface_elevated": "#252122",
      "primary": "#1677FF",
      "accent": "#1677FF",
      "text_primary": "#FAF4D9",
      "text_muted": "rgba(250, 244, 217, 0.65)",
      "border": "rgba(250, 244, 217, 0.12)",
      "glow": "rgba(22, 119, 255, 0.35)",
      "badge_bg": "rgba(22, 119, 255, 0.18)"
    },
    "typography": {
      "display_headline": "Panton Rust Black Base",
      "subtitle_section": "Yolk Bold",
      "technical_code": "VP Pixel",
      "body_fallback": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "headline_weight": "900",
      "subtitle_weight": "700"
    },
    "background": {
      "type": "dynamic_hybrid",
      "radial_depth": true,
      "faint_grid": true,
      "grid_size": "60px",
      "grid_opacity": 0.04
    },
    "containers": {
      "type": "solid_matte_dark",
      "border_width": "1px",
      "border_radius": "20px",
      "shadow": "0 24px 60px rgba(0, 0, 0, 0.45)"
    },
    "motion": {
      "preset": "snappy_tech_springs",
      "spring_hook": {
        "damping": 14,
        "stiffness": 200,
        "mass": 0.6
      },
      "spring_card": {
        "damping": 16,
        "stiffness": 180,
        "mass": 0.7
      },
      "transition_frames": 14,
      "stagger_frames": 5
    },
    "captions": {
      "enabled": false,
      "style": "kinetic_pop_highlight",
      "font_family": "Panton Rust Black Base",
      "active_color": "#1677FF",
      "inactive_color": "#FAF4D9",
      "badge_bg": "#1677FF",
      "placement": "bottom_center",
      "font_size": 48
    }
  },
  "audio": {
    "rule_r1": "STRICTLY NO sound effects, NO background music, NO audio ducking, NO added audio. The narration audio (audio.mp3) is the single audio source.",
    "narration_untouched": true,
    "sfx_enabled": false,
    "bg_music_enabled": false
  },
  "style_bible": "Channels/VantaBrief/style/VantaBrief_Visual_Style_Bible.md",
  "paths": {
    "root": "Channels/VantaBrief",
    "brand": "Channels/VantaBrief/Brand",
    "videos": "Channels/VantaBrief/videos",
    "style": "Channels/VantaBrief/style",
    "media": "Channels/VantaBrief/media",
    "references": "Channels/VantaBrief/references",
    "components": "Channels/VantaBrief/components",
    "templates": "Channels/VantaBrief/templates"
  }
}
