  "scenes": [
    {
      "id": "s01",
      "start": 0.0,
      "end": 5.28,
      "narration": "Silicon Valley spent billions of dollars locking down AI behind expensive monthly subscriptions.",
      "intent": "title",
      "intensity": "hero",
      "assets": [],
      "animations": [
        {
          "id": "A01",
          "params": {
            "title": "Silicon Valley vs DeepSeek",
            "subtitle": "Billions spent locking AI behind subscriptions",
            "icon": "scales"
          }
        },
        {
          "id": "A03",
          "params": {
            "label": "Locked Subscriptions",
            "icon": "warn"
          }
        }
      ]
    },
    {
      "id": "s02",
      "start": 5.28,
      "end": 14.28,
      "narration": "For the past year, the biggest mystery wasn't just how Chinese labs train their models. It was how they managed to sell access to them for pennies while Western companies burned through billions in cloud bills.",
      "intent": "compare",
      "intensity": "medium",
      "assets": [],
      "animations": [
        {
          "id": "A47",
          "params": {
            "a": "How they train?",
            "b": "The mystery"
