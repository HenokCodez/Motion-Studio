    {
      "id": "s19",
      "start": 144.04,
      "end": 152.52,
      "narration": "But it successfully categorizes and counts over 130 individual pastries, factoring in the ones hidden behind the stacks. Even more impressive is the speed.",
      "intent": "stat",
