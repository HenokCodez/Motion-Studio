{
  "name": "whiteboard-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build:plan": "node scripts/build.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node test/negative.test.mjs && node test/v2.test.mjs",
    "studio": "npm run build:plan && remotion studio remotion/index.ts",
    "render": "npm run build:plan && remotion render remotion/index.ts Explainer out/video.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "playwright": "^1.48.0",
    "sharp": "^0.33.0",
    "simple-icons": "^13.0.0",
    "typescript": "^5.5.0"
  }
}
