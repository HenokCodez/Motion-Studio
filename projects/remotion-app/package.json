{
  "name": "remotion-app",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.538",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "^4.0.534",
    "@remotion/layout-utils": "4.0.538",
    "@remotion/media-utils": "4.0.538",
    "@remotion/motion-blur": "4.0.538",
    "@remotion/noise": "4.0.538",
    "@remotion/paths": "^4.0.534",
    "@remotion/shapes": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "playwright": "^1.64.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "roughjs": "^4.6.6",
    "sharp": "0.35.5",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "w2:assets": "node workflow2-whiteboard/scripts/run.mjs scripts/fetch-assets.mjs",
    "w2:plan": "node workflow2-whiteboard/scripts/run.mjs scripts/build.mjs",
    "w2:preview": "node workflow2-whiteboard/scripts/run.mjs scripts/preview.mjs",
    "w2:test": "node workflow2-whiteboard/scripts/run.mjs test/negative.test.mjs && node workflow2-whiteboard/scripts/run.mjs test/v2.test.mjs",
    "w2:measure-font": "node workflow2-whiteboard/scripts/run.mjs scripts/measure-font.mjs",
    "w2:find-icon": "node workflow2-whiteboard/scripts/run.mjs scripts/find-icon.mjs",
    "w2:transcript-to-text": "node workflow2-whiteboard/scripts/run.mjs scripts/transcript-to-text.mjs",
    "w2:words": "node workflow2-whiteboard/scripts/run.mjs scripts/words-from-whisper.mjs",
    "w2:studio": "node workflow2-whiteboard/scripts/run.mjs scripts/build.mjs --allow-missing && remotion studio workflow2-whiteboard/remotion/index.ts",
    "w2:render": "node workflow2-whiteboard/scripts/run.mjs scripts/build.mjs --allow-missing && remotion render workflow2-whiteboard/remotion/index.ts Explainer workflow2-whiteboard/out/video.mp4 --codec=h264 --crf=18"
  }
}
